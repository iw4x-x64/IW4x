libs =

import libs += libcurl%liba{curl}
import libs += libminhook%liba{minhook}
import libs += libquill%liba{quill}

./: lib{iw4x}: {hxx ixx txx cxx}{** -version -xcurl/forward} \
               {hxx            }{    version               } \
               {def            }{iw4x                      } \
               $libs

libs{XCurl}: xcurl/cxx{forward} xcurl/def{XCurl}
{
  bin.lib.prefix = ''
  cxx.loptions = -nostdlib -Wl,--entry=0
  cxx.libs =
}

./: libs{XCurl}

hxx{version}: in{version} $src_root/manifest

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

# C++26 reflection, which GCC keeps behind a flag of its own.
#
# gdk/ builds each recovered vtable out of the entry points declared for it,
# so a slot offset is stated once, on the function that answers it, and the
# table is a compile time constant. See gdk/vtable.hxx.
#
cxx.coptions += -freflection

cxx.libs += -lbcrypt

obja{*}: cxx.poptions += -DLIBIW4X_STATIC_BUILD
objs{*}: cxx.poptions += -DLIBIW4X_SHARED_BUILD

# Link options.
#
# Use DllMain as the image entry point. See iw4x.cxx for why MinGW
# startup cannot happen from the usual loader callback and how we
# arrange to run it afterwards.
#
# There is one slightly non-obvious detail here: dllcrt2.o still needs
# to be linked even though we no longer enter through DllMainCRTStartup.
# _CRT_INIT() lives there and the deferred path in iw4x.cxx calls it
# directly.
#
libs{iw4x}: cxx.loptions += -Wl,--entry=DllMain

# Export options.
#
lib{iw4x}:
{
  cxx.export.poptions = "-I$out_root" "-I$src_root"
  cxx.export.libs = $libs
}

liba{iw4x}: cxx.export.poptions += -DLIBIW4X_STATIC
libs{iw4x}: cxx.export.poptions += -DLIBIW4X_SHARED

# Install options.
#
hxx{*}:     install = false
liba{iw4x}: install = false
libi{*}:    install = false
pc{*}:      install = false
